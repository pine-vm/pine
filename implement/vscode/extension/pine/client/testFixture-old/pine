#!/usr/bin/env node

const fs = require('fs');

let buffer = Buffer.alloc(0);

process.stdin.on('data', chunk => {
    buffer = Buffer.concat([buffer, chunk]);
    processMessages();
});

function processMessages() {
    while (true) {
        const headerEnd = buffer.indexOf('\r\n\r\n');

        if (headerEnd < 0) {
            return;
        }

        const header = buffer.subarray(0, headerEnd).toString('ascii');
        const match = /Content-Length: (\d+)/i.exec(header);

        if (!match) {
            process.exit(1);
        }

        const contentLength = Number(match[1]);
        const messageEnd = headerEnd + 4 + contentLength;

        if (buffer.length < messageEnd) {
            return;
        }

        const content = buffer.subarray(headerEnd + 4, messageEnd).toString('utf8');
        buffer = buffer.subarray(messageEnd);
        handleMessage(JSON.parse(content));
    }
}

function handleMessage(message) {
    if (process.env.OLD_SERVER_REQUEST_LOG) {
        fs.appendFileSync(process.env.OLD_SERVER_REQUEST_LOG, `${message.method ?? 'response'}\n`);
    }

    if (message.id === undefined) {
        if (message.method === 'exit') {
            process.exit(0);
        }

        return;
    }

    let result = null;

    if (message.method === 'initialize') {
        result = {
            capabilities: {
                referencesProvider: true,
                textDocumentSync: 1
            },
            serverInfo: {
                name: 'Pine old-server compatibility fixture',
                version: 'old'
            }
        };
    } else if (message.method === 'textDocument/references') {
        result = [];
    }

    const response = JSON.stringify({ jsonrpc: '2.0', id: message.id, result });
    process.stdout.write(`Content-Length: ${Buffer.byteLength(response)}\r\n\r\n${response}`);
}
