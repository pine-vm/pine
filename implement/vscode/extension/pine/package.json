{
	"name": "pine",
	"displayName": "Pine",
	"description": "Elm developer tools",
	"license": "MIT",
	"version": "0.3.7",
	"author": "Michael Rätzel",
	"repository": {
		"type": "git",
		"url": "https://github.com/pine-vm/pine"
	},
	"publisher": "Pine",
	"categories": [
		"Programming Languages",
		"Testing"
	],
	"icon": "src/pine-icon.png",
	"keywords": [
		"elm"
	],
	"sponsor": {
		"url": "https://github.com/sponsors/Viir"
	},
	"engines": {
		"vscode": "^1.93.0"
	},
	"activationEvents": [
		"workspaceContains:**/elm.json"
	],
	"main": "./client/out/extension",
	"contributes": {
		"languages": [
			{
				"id": "elm",
				"aliases": [
					"Elm",
					"elm"
				],
				"extensions": [
					".elm"
				],
				"configuration": "./src/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "elm",
				"scopeName": "source.elm",
				"path": "./src/syntax.json"
			}
		],
		"configurationDefaults": {
			"[elm]": {
				"editor.tabSize": 4,
				"editor.formatOnSave": true,
				"editor.wordBasedSuggestions": "off"
			}
		},
		"commands": [
			{
				"command": "pine.showLanguageServerClientLog",
				"title": "Pine: Show Language Server Client Log"
			},
			{
				"command": "pine.tests.replay",
				"title": "Pine: Replay Elm Fuzz Test"
			},
			{
				"command": "pine.tests.copyReproduction",
				"title": "Pine: Copy Elm Fuzz Reproduction Command"
			}
		],
		"menus": {
			"testing/item/context": [
				{
					"command": "pine.tests.replay",
					"when": "testControllerId == pine.elm",
					"group": "inline"
				},
				{
					"command": "pine.tests.copyReproduction",
					"when": "testControllerId == pine.elm"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "Pine",
			"properties": {
				"pine.testing.fuzzRuns": {
					"scope": "resource",
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295,
					"default": 100,
					"description": "Default number of examples per Elm fuzz test. Test.fuzzWith can override this."
				},
				"pine.testing.seed": {
					"scope": "resource",
					"type": ["integer", "null"],
					"minimum": 0,
					"maximum": 4294967295,
					"default": null,
					"description": "Elm fuzz seed. Null selects a fresh seed per run; replay uses the recorded seed."
				},
				"pineLanguageServer.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				},
				"pineLanguageServer.pathToPineExecutableFile": {
					"scope": "window",
					"type": "string",
					"default": "",
					"description": "Path to the Pine language server executable file. Empty string falls back to 'pine'"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint ./client/src --ext .ts,.tsx",
		"postinstall": "cd client && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^20",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"eslint": "^8.57.0",
		"mocha": "^11.7.5",
		"typescript": "^5.6.2"
	}
}